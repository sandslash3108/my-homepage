
---
import Layout from '../layouts/Layout.astro';

const newsList = [
	{ title: 'サイトを公開しました。', date: '2026.11.01', datetime: '2026-11-01' },
	{ title: '新しいコンテンツを追加しました。', date: '2026.10.25', datetime: '2026-10-25' },
	{ title: 'サイト制作を開始しました。', date: '2026.10.20', datetime: '2026-10-20' },
];
---

<Layout title="NEWS | さどぱのデカいつぶやき">
	<section class="page-heading">
		<p class="section-label">NEWS</p>
		<h1>お知らせ</h1>
		<p class="description">サイトの更新情報やお知らせ。</p>
	</section>

	<section class="news-list">
		{newsList.map((news) => (
			<a href="/news" class="news-item">
				<time datetime={news.datetime}>{news.date}</time>
				<h2>{news.title}</h2>
				<span class="arrow">→</span>
			</a>
		))}
	</section>
</Layout>

<style>
	.page-heading {
		padding: 4rem 0 2.5rem;
		border-bottom: 1px solid #303b38;
	}

	.section-label {
		margin: 0;
		color: #65c9b5;
		font-size: 0.8rem;
		letter-spacing: 0.15em;
	}

	.page-heading h1 {
		margin: 0.4rem 0;
		font-size: 2.2rem;
		font-weight: 700;
	}

	.description {
		margin: 0;
		color: #a5afab;
		font-size: 0.9rem;
	}

	.news-list {
		padding: 1rem 0 5rem;
	}

	.news-item {
		display: grid;
		grid-template-columns: 130px 1fr 30px;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid #303b38;
		color: #f4f4f4;
		text-decoration: none;
		transition: color 0.2s;
	}

	.news-item:hover {
		color: #65c9b5;
	}

	.news-item time {
		color: #65c9b5;
		font-size: 0.85rem;
	}

	.news-item h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.arrow {
		color: #65c9b5;
		text-align: right;
	}

	@media (max-width: 700px) {
		.page-heading {
			padding: 2.5rem 0 1.5rem;
		}

		.page-heading h1 {
			font-size: 1.7rem;
		}

		.news-item {
			grid-template-columns: 1fr 20px;
			gap: 0.5rem;
			padding: 1.2rem 0;
		}

		.news-item time {
			grid-column: 1;
			font-size: 0.75rem;
		}

		.news-item h2 {
			grid-column: 1;
			font-size: 0.9rem;
		}

		.arrow {
			grid-column: 2;
			grid-row: 1 / 3;
		}
	}
</style>
