
---
import Layout from '../layouts/Layout.astro';

const articles = [
	{ genre: '短編', title: 'ここに短編のタイトル', number: '01', path: 'sample', thumbnail: '/images/sample-thumbnail.jpg' },
	{ genre: 'ミステリー', title: 'ここにミステリーのタイトル', number: '02', path: 'sample2', thumbnail: '/images/sample-thumbnail02.jpg' },
	{ genre: '記事', title: 'ここに記事のタイトル', number: '03', path: 'sample', thumbnail: '/images/sample-thumbnail.jpg' },
	{ genre: '短編', title: 'ここに短編のタイトル', number: '04', path: 'sample', thumbnail: '/images/sample-thumbnail02.jpg' },
	{ genre: 'ミステリー', title: 'ここにミステリーのタイトル', number: '05', path: 'sample', thumbnail: '/images/sample-thumbnail.jpg' },
	{ genre: '記事', title: 'ここに記事のタイトル', number: '06', path: 'sample', thumbnail: '/images/sample-thumbnail02.jpg' },
];
const newsList = [
	{ title: 'サイトを公開しました。', date: '2026.11.01', datetime: '2026-11-01', path: 'sample' },
	{ title: '新しいコンテンツを追加しました。', date: '2026.10.25', datetime: '2026-10-25', path: 'sample' },
	{ title: 'サイト制作を開始しました。', date: '2026.10.20', datetime: '2026-10-20', path: 'sample' },
];
---

<Layout title="さどぱのデカいつぶやき">
	<section class="main-visual">
		<img
			src="/images/main-visual.jpg"
			alt="さどぱのデカいつぶやき"
		/>
	</section>

	<section class="contents">
		<div class="section-heading">
			<div>
				<p class="section-label">CONTENTS</p>
				<h2>コンテンツ一覧</h2>
			</div>
			<a href="/contents" class="more-link">もっと見る →</a>
		</div>

		<div class="article-list">
	{articles.map((article) => (
		<a href={`/contents/${article.path}`} class="article-card">
			<div class="thumbnail">
				<img src={article.thumbnail} alt={article.title} />
			</div>
			<p class="genre">{article.genre}</p>
			<h3>{article.title}</h3>
		</a>
	))}
</div>
	</section>
	
	<section class="news">
		<div class="section-heading">
			<div>
				<p class="section-label">NEWS</p>
				<h2>お知らせ</h2>
			</div>
			<a href="/news" class="more-link">もっと見る →</a>
		</div>

		<div class="news-list">
	{newsList.map((news) => (
		<a href={`/news/${news.path}`} class="news-item">
			<time datetime={news.datetime}>{news.date}</time>
			<span>{news.title}</span>
		</a>
	))}
</div>
	</section>
</Layout>

<style>
	.main-visual {
		min-height: 65vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 0;
	}

	.main-visual img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	.contents {
		padding: 3rem 0 5rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		margin-bottom: 2rem;
		border-bottom: 1px solid #303b38;
		padding-bottom: 1rem;
	}

	.section-label {
		margin: 0;
		color: #65c9b5;
		font-size: 0.8rem;
		letter-spacing: 0.15em;
	}

	.section-heading h2 {
    margin: 0.2rem 0 0;
    font-size: 1.8rem;
    font-weight: 700;
　　}

	.more-link {
		color: #65c9b5;
		font-size: 0.8rem;
		text-decoration: none;
		letter-spacing: 0.08em;
	}

	.article-list {
		display: flex;
		gap: 1.5rem;
		overflow-x: auto;
		padding-bottom: 1rem;
		scrollbar-color: #65c9b5 #1b2421;
	}

	.article-card {
		flex: 0 0 240px;
		color: #f4f4f4;
		text-decoration: none;
	}

	.thumbnail {
	aspect-ratio: 16 / 10;
	overflow: hidden;
	background: #1b2421;
	border: 1px solid #303b38;
}

.thumbnail img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	transition: transform 0.2s;
}

.article-card:hover .thumbnail img {
	transform: scale(1.03);
}

	.genre {
		margin: 0.8rem 0 0.2rem;
		color: #65c9b5;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
	}

	.article-card h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}

	@media (max-width: 700px) {
		.main-visual {
			min-height: auto;
			padding: 2rem 0;
		}

		.contents {
			padding: 2rem 0 3rem;
		}

		.section-heading h2 {
			font-size: 1.4rem;
		}

		.article-card {
			flex-basis: 200px;
		}
	}
	
	.news {
		padding: 2rem 0 5rem;
	}

	.news-list {
		border-top: 1px solid #303b38;
	}

	.news-item {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.2rem 0;
		border-bottom: 1px solid #303b38;
		color: #f4f4f4;
		text-decoration: none;
		transition: color 0.2s;
	}

	.news-item:hover {
		color: #65c9b5;
	}

	.news-item time {
		flex: 0 0 110px;
		color: #65c9b5;
		font-size: 0.85rem;
	}

	.news-item span {
		font-size: 0.95rem;
		font-weight: 500;
	}

	@media (max-width: 700px) {
		.news {
			padding: 1rem 0 3rem;
		}

		.news-item {
			gap: 1rem;
			padding: 1rem 0;
		}

		.news-item time {
			flex-basis: 90px;
			font-size: 0.75rem;
		}

		.news-item span {
			font-size: 0.85rem;
		}
	}

</style>
