
---
import Layout from '../layouts/Layout.astro';

const posts = [
	{ title: 'ここにブログのタイトル', number: '01', date: '2026.11.01', thumbnail: '/images/sample-thumbnail.jpg', path: 'sample' },
	{ title: 'ここにブログのタイトル', number: '02', date: '2026.10.25', thumbnail: '/images/sample-thumbnail02.jpg', path: 'sample' },
	{ title: 'ここにブログのタイトル', number: '03', date: '2026.10.20', thumbnail: '/images/sample-thumbnail.jpg', path: 'sample' },
	{ title: 'ここにブログのタイトル', number: '04', date: '2026.10.15', thumbnail: '/images/sample-thumbnail02.jpg', path: 'sample' },
	{ title: 'ここにブログのタイトル', number: '05', date: '2026.10.10', thumbnail: '/images/sample-thumbnail.jpg', path: 'sample' },
	{ title: 'ここにブログのタイトル', number: '06', date: '2026.10.05', thumbnail: '/images/sample-thumbnail02.jpg', path: 'sample' },
];
---

<Layout title="BLOG | さどぱのデカいつぶやき">
	<section class="page-heading">
		<p class="section-label">BLOG</p>
		<h1>ブログ</h1>
		<p class="description">日々の記録や、どこかへ出かけた話。</p>
	</section>

	<section class="post-grid">
		{posts.map((post) => (
			<a href={`/blog/${post.path}`} class="post-card">
				<div class="thumbnail">
	<img src={post.thumbnail} alt={post.title} />
</div>
				<h2>{post.title}</h2>
				<time>{post.date}</time>
			</a>
		))}
	</section>
    <nav class="pagination" id="pagination" aria-label="ページ送り">
</nav>
</Layout>

<style>
	.page-heading {
		padding: 4rem 0 2.5rem;
		border-bottom: 1px solid #303b38;
	}

	.section-label {
		margin: 0;
		color: #65c9b5;
		font-size: 0.8rem;
		letter-spacing: 0.15em;
	}

	.page-heading h1 {
		margin: 0.4rem 0;
		font-size: 2.2rem;
		font-weight: 700;
	}

	.description {
		margin: 0;
		color: #a5afab;
		font-size: 0.9rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 3rem 1.5rem;
		padding: 2.5rem 0 5rem;
	}

	.post-card {
		color: #f4f4f4;
		text-decoration: none;
	}

	.thumbnail {
	aspect-ratio: 16 / 10;
	overflow: hidden;
	background: #1b2421;
	border: 1px solid #303b38;
}

.thumbnail img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	transition: transform 0.2s;
}

.post-card:hover .thumbnail img {
	transform: scale(1.03);
}

	.post-card h2 {
		margin: 0.8rem 0 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.post-card time {
		display: block;
		margin-top: 0.6rem;
		color: #84908b;
		font-size: 0.75rem;
	}

	@media (max-width: 700px) {
		.page-heading {
			padding: 2.5rem 0 1.5rem;
		}

		.page-heading h1 {
			font-size: 1.7rem;
		}

		.post-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-top: 1.5rem;
		}
	}
    .pagination {
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 0.7rem;
	margin-top: 3rem;
}

.pagination a,
.pagination span {
	display: inline-flex;
	justify-content: center;
	align-items: center;
	min-width: 2.5rem;
	height: 2.5rem;
	padding: 0 0.7rem;
	border: 1px solid #303b38;
	color: #f4f4f4;
	text-decoration: none;
	font-size: 0.85rem;
}

.pagination a:hover,
.pagination a.current {
	background: #65c9b5;
	border-color: #65c9b5;
	color: #101413;
}

.pagination span {
	border: none;
}
</style>
<script>
	const postCards = Array.from(document.querySelectorAll('.post-card'));
	const pagination = document.querySelector('#pagination');

	const perPage = 12;
	let currentPage = 1;

	function showPosts() {
		const totalPages = Math.ceil(postCards.length / perPage);

		const start = (currentPage - 1) * perPage;
		const end = start + perPage;

		postCards.forEach((card) => {
			(card as HTMLElement).style.display = 'none';
		});

		postCards.slice(start, end).forEach((card) => {
			(card as HTMLElement).style.display = '';
		});

		showPagination(totalPages);
	}

	function showPagination(totalPages: number) {
		if (!pagination) return;

		pagination.innerHTML = '';

		if (totalPages <= 1) return;

		for (let page = 1; page <= totalPages; page++) {
			const link = document.createElement('a');
			link.href = '#';
			link.textContent = String(page);

			if (page === currentPage) {
				link.classList.add('current');
			}

			link.addEventListener('click', (event) => {
				event.preventDefault();
				currentPage = page;
				showPosts();
			});

			pagination.appendChild(link);
		}

		if (currentPage < totalPages) {
			const next = document.createElement('a');
			next.href = '#';
			next.textContent = '次へ →';

			next.addEventListener('click', (event) => {
				event.preventDefault();
				currentPage++;
				showPosts();
			});

			pagination.appendChild(next);
		}
	}

	showPosts();
</script>