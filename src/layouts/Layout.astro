
---
const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#101413" />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
    href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    rel="stylesheet"
        />
	</head>

	<body>
		<header>
			<div class="header-inner">
				<a href="/" class="logo" aria-label="ホーム">
					<span>デカ</span>
					<span>つぶ</span>
				</a>

				<nav class="desktop-nav">
					<a href="/contents">CONTENTS</a>
					<a href="/blog">BLOG</a>
					<a href="/news">NEWS</a>
					<a href="/about">ABOUT</a>
					<a href="/links">LINKS</a>
				</nav>

				<details class="mobile-nav">
                    <summary aria-label="メニュー">
                        <span></span>
                        <span></span>
                        <span></span>
                    </summary>
                    <nav>
						<a href="/contents">CONTENTS</a>
						<a href="/blog">BLOG</a>
						<a href="/news">NEWS</a>
						<a href="/about">ABOUT</a>
						<a href="/links">LINKS</a>
					</nav>
				</details>
			</div>
		</header>

		<main>
			<slot />
		</main>

		
<footer>
	<div class="footer-inner">
		<div class="footer-top">
			<div>
				<div class="footer-logo">
					<span>デカ</span>
					<span>つぶ</span>
				</div>
				<p>SADOPA'S BIG TWEETS</p>
			</div>

			<nav class="footer-nav">
				<a href="https://x.com/" target="_blank" rel="noopener noreferrer">X</a>
				<a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://note.com/" target="_blank" rel="noopener noreferrer">note</a>
			</nav>
		</div>

		<p class="copyright">© SADOPA</p>
	</div>
</footer>

	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		background-color: #101413;
	}

	:global(body) {
		margin: 0;
		font-family: "Zen Kaku Gothic New", sans-serif;
		color: #f4f4f4;
		background-color: #101413;
		line-height: 1.8;
	}

	header {
		border-bottom: 1px solid #303b38;
	}

	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.2rem 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		display: flex;
		flex-direction: column;
		color: #65c9b5;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.15;
		text-decoration: none;
	}

	.desktop-nav {
		display: flex;
		gap: 2rem;
	}

	.desktop-nav a,
	.mobile-nav a {
		color: #f4f4f4;
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		letter-spacing: 0.08em;
		transition: color 0.2s;
	}

	.desktop-nav a:hover,
	.mobile-nav a:hover {
		color: #65c9b5;
	}

	.mobile-nav {
		display: none;
	}

	main {
		max-width: 1200px;
		min-height: 70vh;
		margin: 0 auto;
		padding: 3rem 2rem;
	}

	footer {
		border-top: 1px solid #303b38;
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 2rem;
	}

	.footer-logo {
		display: flex;
		flex-direction: column;
		color: #65c9b5;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.1;
	}

	.footer-inner p {
		color: #a0aaa6;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
	}

	.footer-inner .copyright {
		margin-top: 2rem;
		color: #68716e;
	}

	@media (max-width: 700px) {
		.header-inner {
			padding: 1rem 1.2rem;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-nav {
			display: block;
			position: relative;
		}

		.mobile-nav summary {
    width: 32px;
    height: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
}

.mobile-nav summary::-webkit-details-marker {
    display: none;
}

.mobile-nav summary span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #65c9b5;
    transition: transform 0.25s, opacity 0.25s;
}

/* メニューを開いたときに3本線を×にする */
.mobile-nav[open] summary span:first-child {
    transform: translateY(13px) rotate(45deg);
}

.mobile-nav[open] summary span:nth-child(2) {
    opacity: 0;
}

.mobile-nav[open] summary span:last-child {
    transform: translateY(-13px) rotate(-45deg);
}

		.mobile-nav nav {
			position: absolute;
			top: 2rem;
			right: 0;
			z-index: 10;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			min-width: 180px;
			padding: 1.5rem;
			background-color: #1b2421;
			border: 1px solid #3a4b45;
		}

		main {
			padding: 2rem 1.2rem;
		}

		.footer-inner {
			padding: 2rem 1.2rem;
		}
	}
	.logo,
     .footer-logo {
      font-family: "Dela Gothic One", sans-serif;
	  -webkit-text-stroke: 0.05px #101413;
    }
	
	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}

	.footer-nav {
		display: flex;
		gap: 1.5rem;
	}

	.footer-nav a {
		color: #f4f4f4;
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-nav a:hover {
		color: #65c9b5;
	}

	@media (max-width: 700px) {
		.footer-top {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.5rem;
		}
	}

</style>
